# Adapted from TP-Aleks/platforms/switch/cmake/DevkitA64Libnx.cmake. Native Windows CMake can reuse the official
# platform module.
set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro installation")
set(ENV{DEVKITPRO} "${DEVKITPRO}")
set(ENV{DEVKITA64} "${DEVKITPRO}/devkitA64")
set(NX_ROOT "${DEVKITPRO}/libnx")
set(CMAKE_SYSTEM_NAME NintendoSwitch)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(SWITCH TRUE)
list(APPEND CMAKE_MODULE_PATH "${DEVKITPRO}/cmake")
foreach(_par "C;gcc" "CXX;g++" "ASM;gcc")
  list(GET _par 0 _lenguaje)
  list(GET _par 1 _programa)
  find_program(CMAKE_${_lenguaje}_COMPILER NAMES aarch64-none-elf-${_programa}
    HINTS "${DEVKITPRO}/devkitA64/bin" NO_DEFAULT_PATH REQUIRED)
endforeach()
find_program(CMAKE_AR NAMES aarch64-none-elf-gcc-ar HINTS "${DEVKITPRO}/devkitA64/bin" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_RANLIB NAMES aarch64-none-elf-gcc-ranlib HINTS "${DEVKITPRO}/devkitA64/bin" NO_DEFAULT_PATH REQUIRED)
find_program(NX_ELF2NRO_EXE NAMES elf2nro HINTS "${DEVKITPRO}/tools/bin" NO_DEFAULT_PATH REQUIRED)
find_program(NX_NACPTOOL_EXE NAMES nacptool HINTS "${DEVKITPRO}/tools/bin" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/libnx" "${DEVKITPRO}/portlibs/switch" "${DEVKITPRO}/devkitA64")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
add_compile_definitions(__SWITCH__=1 TARGET_SWITCH=1 _DEFAULT_SOURCE)
