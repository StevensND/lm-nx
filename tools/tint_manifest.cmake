# Evaluate original BUILD.cmake files to resolve Tint sources. Do not configure compilers, run Ninja or create
# Dawn targets.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED TINT_ROOT OR NOT DEFINED SALIDA)
  message(FATAL_ERROR "Missing TINT_ROOT and SALIDA")
endif()
set(TINT_BUILD_WGSL_READER ON)
set(TINT_BUILD_WGSL_WRITER ON)
set(TINT_BUILD_GLSL_WRITER ON)
if(NOT DEFINED TINT_BUILD_IS_WIN)
  set(TINT_BUILD_IS_WIN ON)
endif()
set(TINT_BUILD_CMD_TOOLS OFF)
set(TINT_BUILD_TESTS OFF)
set(TINT_BUILD_BENCHMARKS OFF)
set(TINT_BUILD_FUZZERS OFF)
set(TINT_BUILD_IR_BINARY OFF)
file(WRITE "${SALIDA}" "")
function(tint_add_target nombre tipo)
  if(tipo STREQUAL "lib")
    file(APPEND "${SALIDA}" "S|${nombre}|${ARGN}\n")
  endif()
endfunction()
function(tint_target_add_sources nombre tipo)
  if(tipo STREQUAL "lib")
    file(APPEND "${SALIDA}" "S|${nombre}|${ARGN}\n")
  endif()
endfunction()
function(tint_target_add_dependencies nombre tipo)
  if(tipo STREQUAL "lib")
    file(APPEND "${SALIDA}" "D|${nombre}|${ARGN}\n")
  endif()
endfunction()
function(tint_target_add_external_dependencies nombre tipo)
  if(tipo STREQUAL "lib")
    file(APPEND "${SALIDA}" "E|${nombre}|${ARGN}\n")
  endif()
endfunction()
function(tint_target_set_output_name nombre tipo salida_nombre)
endfunction()
list(APPEND CMAKE_MODULE_PATH "${TINT_ROOT}/src/tint")
include("${TINT_ROOT}/src/tint/BUILD.cmake")
