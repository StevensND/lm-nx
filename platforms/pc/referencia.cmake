# Separate Dawn reference path; not used by the native renderer or Switch.
set(DAWN_FETCH_DEPENDENCIES OFF CACHE BOOL "" FORCE)
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "" FORCE)
foreach(op DAWN_BUILD_TESTS DAWN_BUILD_SAMPLES DAWN_USE_GLFW DAWN_BUILD_NODE_BINDINGS DAWN_BUILD_PROTOBUF DAWN_ENABLE_D3D11 DAWN_ENABLE_D3D12 DAWN_ENABLE_NULL DAWN_ENABLE_DESKTOP_GL DAWN_ENABLE_OPENGLES DAWN_USE_BUILT_DXC TINT_BUILD_TESTS TINT_BUILD_CMD_TOOLS)
  set(${op} OFF CACHE BOOL "" FORCE)
endforeach()
set(DAWN_ENABLE_VULKAN ON CACHE BOOL "" FORCE)
set(DAWN_USE_WINDOWS_UI OFF CACHE BOOL "No UWP surfaces; the test uses Win32 HWND" FORCE)
set(DAWN_ABSEIL_DIR ${DEP_ABSEIL_CPP} CACHE PATH "" FORCE)
set(DAWN_SPIRV_HEADERS_DIR ${DEP_SPIRV_HEADERS} CACHE PATH "" FORCE)
set(DAWN_SPIRV_TOOLS_DIR ${DEP_SPIRV_TOOLS} CACHE PATH "" FORCE)
set(DAWN_GLSLANG_DIR ${DEP_GLSLANG} CACHE PATH "" FORCE)
set(DAWN_VULKAN_HEADERS_DIR ${LMNX_COPIAS}/plume-vulkan/contrib/Vulkan-Headers CACHE PATH "" FORCE)
# UtilityHeaders needs headers from the same SDK. plume's vendored headers are older and lack VkCudaFunctionNV.
include_directories(BEFORE "${LMNX_COPIAS}/vulkan-sdk/include")
# Use locally installed tools; do not download generators or headers.
if(EXISTS "$ENV{VULKAN_SDK}/Include/vulkan/utility/vk_struct_helper.hpp")
  add_library(Vulkan::UtilityHeaders INTERFACE IMPORTED)
  set_target_properties(Vulkan::UtilityHeaders PROPERTIES SYSTEM FALSE INTERFACE_INCLUDE_DIRECTORIES "${LMNX_COPIAS}/vulkan-sdk/include")
endif()
add_subdirectory(${DEP_DAWN} ${CMAKE_BINARY_DIR}/dawn EXCLUDE_FROM_ALL)
target_compile_options(absl_time_zone PRIVATE -include winstring.h)
add_library(lmnx_pc_aurora STATIC ${LMNX_AURORA_SOURCES})
target_compile_definitions(lmnx_pc_aurora PUBLIC WEBGPU_DAWN=1 DAWN_ENABLE_BACKEND_VULKAN=1)
target_compile_definitions(lmnx_pc_runtime PRIVATE WEBGPU_DAWN=1)
set_source_files_properties(${LMNX_AURORA}/lib/dawn/TracyPlatform.cpp PROPERTIES COMPILE_OPTIONS "-fno-rtti")
set_source_files_properties(${LMNX_AURORA}/lib/card/DolphinCardPath.cpp PROPERTIES COMPILE_DEFINITIONS "UNICODE;_UNICODE")
target_link_libraries(lmnx_pc_aurora PUBLIC webgpu_dawn SDL3::SDL3-static lmnx_png libzstd_static absl::flat_hash_map absl::flat_hash_set absl::btree)
add_executable(ProjectLM-NX-PC-Dawn main.cpp ${DEP_IMGUI}/imgui.cpp ${DEP_IMGUI}/imgui_draw.cpp ${DEP_IMGUI}/imgui_tables.cpp ${DEP_IMGUI}/imgui_widgets.cpp
    ${DEP_IMGUI}/backends/imgui_impl_sdl3.cpp ${DEP_IMGUI}/backends/imgui_impl_wgpu.cpp ${DEP_IMGUI}/backends/imgui_impl_sdlrenderer3.cpp
    ${LMNX_RAIZ}/platforms/switch/nod/nod_gcn.cpp ${LMNX_RAIZ}/LMNX-Deko3D/third_party/xxhash/xxhash.c ${DEP_SQLITE}/sqlite3.c)
target_compile_definitions(ProjectLM-NX-PC-Dawn PRIVATE IMGUI_IMPL_WEBGPU_BACKEND_DAWN)
target_link_libraries(ProjectLM-NX-PC-Dawn PRIVATE -Wl,--whole-archive lmnx_pc_runtime -Wl,--no-whole-archive lmnx_pc_aurora SDL3::SDL3-static psapi dbghelp ws2_32 winmm bcrypt winhttp shell32 ole32 uuid ntdll dxgi wbemuuid)
target_link_options(ProjectLM-NX-PC-Dawn PRIVATE -static -static-libgcc -static-libstdc++)
if(LMNX_TRACY)
  target_link_libraries(ProjectLM-NX-PC-Dawn PRIVATE lmnx_tracy)
endif()
